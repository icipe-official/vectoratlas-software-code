  "AboutPage": {
    "sectionHeaders": {
      "about": "About",
      "team": "The Team",
      "contact": "Contact",
      "partners": "Partners"
    },
    "contact": {
      "projectTeam": "project team",
      "email": "Email",
      "getInTouch": "Get in touch with our dedicated team for any inquiries or collaboration opportunities"
