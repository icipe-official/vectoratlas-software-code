#: ../../contributing-data-to-the-atlas/uploading-data.md:1
msgid "DATA UPLOAD"
msgstr "CARREGAMENTO DE DADOS"

#: ../../contributing-data-to-the-atlas/uploading-data.md:3
msgid "Click on the `upload` link in the navigation bar."
msgstr "Clique na ligação de carregamento na barra de navegação."

#: ../../contributing-data-to-the-atlas/uploading-data.md:4
msgid "You will be directed to the upload interface."
msgstr "Será redirecionado para a interface de carregamento."

