{
  "name": "occurrencegeojob",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "npm run clean && npm run build && npm run start",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "occurrence",
    "GeoJSON",
    "Job"
  ],
  "author": "Vector Atlas Team",
  "license": "MIT",
  "description": "Pre-process and create GeoJSON and other data as a single json file for fast client-side loading.",
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/pg-cursor": "^2.7.2",
    "@types/proj4": "^2.5.6",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "lodash-es": "^4.18.1",
    "ol": "^10.9.0",
    "pg": "^8.22.0",
    "pg-cursor": "^2.21.0",
    "proj4": "^2.20.9",
    "winston": "^3.19.0"
  }
}
