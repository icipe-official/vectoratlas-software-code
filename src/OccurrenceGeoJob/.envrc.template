# PostgreSQL Configuration
export PGPORT=5432
export PGUSER=postgres
export PGPASSWORD=postgrespass
export PGDATABASE=mva
export PGHOST=127.0.0.1
# Set to true to enable SSL/TLS for connections to Azure managed PostgreSQL (default: false)
export PGSSL=false

# Logging Configuration
export LOGGER_LEVEL=debug
export LOGGER_OUTPUT=console # console or json

# Directory Configuration
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
export OCC_GEO_JOB_SQL_QUERIES_FOLDER=$SCRIPT_DIR/sql

# Atomic Operations Configuration
# Environment variables take precedence over OCC_GEO_JOB_FILE_PATHS_CONFIG
export OCC_GEO_JOB_TARGET_DIRECTORY=$SCRIPT_DIR/.tmp/target
export OCC_GEO_JOB_STAGING_DIRECTORY=$SCRIPT_DIR/.tmp/staging

# Optional: Path to JSON configuration file (environment variables override this)
# export OCC_GEO_JOB_FILE_PATHS_CONFIG=$SCRIPT_DIR/file-paths.config.json

# Atomic file replacement settings
export OCC_GEO_JOB_CREATE_BACKUP=false

# Performance Configuration
# Number of records to fetch per batch. Lower values use less memory but may be slower
export OCC_GEO_JOB_BATCH_SIZE=1000
