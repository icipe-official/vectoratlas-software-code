# .env  (project root)


# ── Database ──────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=vectoratlas
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=vectoratlas


# ── API ───────────────────────────────────────────
API_PORT=3001
NODE_ENV=development


# ── Auth0 (development values) ────────────────────
AUTH0_DOMAIN=your-dev-tenant.auth0.com
AUTH0_AUDIENCE=https://your-dev-tenant.auth0.com/api/v2/
AUTH0_CLIENT_ID=your-client-id

AUTH0_CLIENT_SECRET=your-client-secret

# ── Tile Server ───────────────────────────────────
TILE_SERVER_URL=http://localhost:8080
